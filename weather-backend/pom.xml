<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>com.app</groupId>
    <artifactId>weather-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>weather-backend</name>
    <description>Weather App Backend - Phase A</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!--
            DEPENDENCY 1: spring-boot-starter-web
            ───────────────────────────────────────
            WHY: This is the core of our backend.
            It gives us:
              - Embedded Tomcat server (no external server needed)
              - Spring MVC (for @RestController, @GetMapping etc.)
              - RestTemplate (to call OpenWeather API from our backend)
              - Jackson (to auto-convert Java objects to/from JSON)

            Without this, we cannot build REST APIs at all.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            DEPENDENCY 2: spring-boot-starter-validation
            ─────────────────────────────────────────────
            WHY: Lets us validate incoming request parameters.
            Example: @NotBlank on city name so if someone calls
            /api/weather?city=  (blank), we return a proper error
            instead of sending a bad request to OpenWeather.

            Used with @Valid, @NotBlank, @Size annotations.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            DEPENDENCY 3: lombok
            ─────────────────────
            WHY: Eliminates boilerplate Java code.
            Instead of writing 50 lines of getters/setters/constructors
            for every DTO, we write one annotation:
              @Data      → generates getters + setters
              @Builder   → generates builder pattern
              @NoArgsConstructor / @AllArgsConstructor → constructors

            This is optional but used in all production Spring Boot projects.
            If you prefer not to use it, you can write getters/setters manually.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            DEPENDENCY 4: spring-boot-starter-cache
            ─────────────────────────────────────────
            WHY: Prepares the caching infrastructure for Phase B.
            In Phase A it does nothing visible, but adding it now means
            when we add @Cacheable to WeatherService later, it just works.

            Caching prevents us from calling OpenWeather API every single
            time — instead we return the cached response for 10 minutes.
            This saves API quota and makes responses instant.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!--
            TEST DEPENDENCY
            ────────────────
            WHY: Standard Spring Boot testing.
            Includes JUnit 5 + Mockito.
            Used to write unit tests for WeatherService.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!--
                Spring Boot Maven Plugin
                ─────────────────────────
                WHY: Lets you run the app with: mvn spring-boot:run
                Also packages it as a single executable JAR.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclude Lombok from the final JAR (only needed at compile time) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>